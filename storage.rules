rules_version = '2';

/**
 * Firebase Storage Rules for sleepy.help
 *
 * Currently: No user uploads planned
 * Future: User profile pictures (if accounts feature added)
 */

service firebase.storage {
  match /b/{bucket}/o {

    // Default: deny all (no storage features yet)
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Future: User avatars (Phase 4+)
    // match /users/{userId}/avatar {
    //   allow read: if true; // Public avatars
    //   allow write: if request.auth.uid == userId
    //              && request.resource.size < 2 * 1024 * 1024  // Max 2MB
    //              && request.resource.contentType.matches('image/.*');
    // }
  }
}
