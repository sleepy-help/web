rules_version = '2';

/**
 * Firestore Security Rules for sleepy.help
 *
 * Privacy-First Principles:
 * 1. Users can only access their own data
 * 2. No public reads/writes (except anonymous analytics)
 * 3. Validate all writes
 * 4. Encrypt sensitive data at application layer (before Firestore)
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function validateSettings(data) {
      return data.keys().hasAll(['wakeTime', 'timezone', 'sleepCycles'])
        && data.wakeTime is string
        && data.timezone is string
        && data.sleepCycles is number
        && data.sleepCycles >= 4
        && data.sleepCycles <= 7;
    }

    // User data - only the user can access their own data
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);

      // User settings
      match /settings/{document=**} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if isAuthenticated()
                     && isOwner(userId)
                     && validateSettings(request.resource.data);
      }

      // Smart home integrations (tokens are encrypted at app level)
      match /integrations/{integration} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if isAuthenticated() && isOwner(userId);
      }

      // Sleep logs (Phase 3: Health Tracking)
      match /sleep_logs/{date} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if isAuthenticated()
                     && isOwner(userId)
                     && request.resource.data.keys().hasAll(['date', 'bedtime', 'wakeTime']);
      }
    }

    // Anonymous usage analytics (privacy-preserving)
    // Only aggregated, no PII
    match /analytics/{document=**} {
      allow read: if false; // Only backend can read
      allow write: if true; // Anyone can write anonymous events
    }

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
